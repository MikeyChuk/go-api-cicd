{
  "containerDefinitions": [
    {
      "name": "api",
      "image": "303974373405.dkr.ecr.eu-west-1.amazonaws.com/stacklaunch-go-api:v6",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,

      "environment": [
        {
          "name": "DB_HOST",
          "value": "db-stacklaunch.cxes4uuugay0.eu-west-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_USER",
          "value": "postgres_admin"
        },
        {
          "name": "DB_NAME",
          "value": "postgres"
        },
        {
          "name": "DB_SSLMODE",
          "value": "require"
        }
      ],

      "mountPoints": [],
      "volumesFrom": [],

      "linuxParameters": {
        "initProcessEnabled": true
      },

      "secrets": [

        {
        "name": "DB_PASSWORD",
        "valueFrom": "arn:aws:secretsmanager:eu-west-1:303974373405:secret:stacklaunch/dev/api/database-zuhueH"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/stacklaunch-api",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      },

      "systemControls": []
    }
  ],

  "family": "stacklaunch-api",

  "taskRoleArn": "arn:aws:iam::303974373405:role/stacklaunch-dev-ecs-task-role",

  "executionRoleArn": "arn:aws:iam::303974373405:role/stacklaunch-dev-ecs-task-execution-role",

  "networkMode": "awsvpc",

  "volumes": [],

  "placementConstraints": [],

  "requiresCompatibilities": [
    "FARGATE"
  ],

  "cpu": "256",
  "memory": "512",

  "tags": [
    {
      "key": "Project",
      "value": "stacklaunch"
    },
    {
      "key": "Environment",
      "value": "dev"
    },
    {
      "key": "ManagedBy",
      "value": "Terraform"
    },
    {
      "key": "Platform",
      "value": "StackLaunch"
    },
    {
      "key": "Client",
      "value": "stacklaunch-lab"
    }
  ]
}