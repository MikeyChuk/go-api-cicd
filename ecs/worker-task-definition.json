{
    "containerDefinitions": [
        {
            "name": "worker",
            "image": "303974373405.dkr.ecr.eu-west-1.amazonaws.com/stacklaunch-sqs-app:v1",
            "cpu": 0,
            "portMappings": [],
            "essential": true,
            "command": [
                "python",
                "worker.py"
            ],
            "environment": [
                {
                    "name": "QUEUE_URL",
                    "value": "https://sqs.eu-west-1.amazonaws.com/303974373405/stacklaunch-dev-background-jobs"
                },
                {
                    "name": "AWS_REGION",
                    "value": "eu-west-1"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/stacklaunch-worker-dev",
                    "awslogs-region": "eu-west-1",
                    "awslogs-stream-prefix": "worker"
                }
            },
            "systemControls": []
        }
    ],
    "family": "stacklaunch-worker-dev",
    "taskRoleArn": "arn:aws:iam::303974373405:role/stacklaunch-worker-dev-task-role",
    "executionRoleArn": "arn:aws:iam::303974373405:role/stacklaunch-worker-dev-execution-role",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "tags": [
        {
            "key": "Project",
            "value": "StackLaunch"
        },
        {
            "key": "ManagedBy",
            "value": "Terraform"
        },
        {
            "key": "Platform",
            "value": "StackLaunch"
        },
        {
            "key": "Environment",
            "value": "dev"
        },
        {
            "key": "Service",
            "value": "worker"
        },
        {
            "key": "Client",
            "value": "stacklaunch-lab"
        },
        {
            "key": "Module",
            "value": "ecs-worker-service"
        },
        {
            "key": "Application",
            "value": "background-workers"
        },
        {
            "key": "Name",
            "value": "stacklaunch-worker-dev"
        }
    ]
}